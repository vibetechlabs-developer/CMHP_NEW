# Copy this file to .env (in this same backend/ directory) and fill in
# real values. .env is gitignored and must never be committed.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# local | production settings module is chosen by manage.py/wsgi.py, not by
# this file. These flags only apply within local.py / production.py.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection. No SQLite fallback exists - these are required.
DB_NAME=change-me
DB_USER=change-me
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Cross-origin browser access (local.py and production.py both read these).
# Leave both empty for a plain local run (frontend and backend on the same
# machine, no browser cross-origin calls). Set them when a frontend on a
# different origin/machine needs to call this API directly from the browser
# (e.g. a teammate's machine on the same LAN) - comma-separated, scheme +
# host + port, no trailing slash, no wildcards (required together, since
# CSRF and CORS are checked independently but both must allow the origin):
#   DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
#   DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CORS_ALLOWED_ORIGINS=

# Production-only (see config/settings/production.py).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=0

# JWT lifetimes and login throttle (all optional - shown here with their
# built-in defaults from config/settings/base.py; uncomment to override).
# JWT_ACCESS_TOKEN_MINUTES=5
# JWT_REFRESH_TOKEN_DAYS=1
# AUTH_LOGIN_THROTTLE_RATE=5/min
